# AWS Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE=job-resume-analyzer-dev
S3_BUCKET=job-resume-uploads-dev

# AI Configuration
# Option 1: Use OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Use AWS Bedrock (recommended for AWS deployments)
USE_BEDROCK=true
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# App Configuration
NODE_ENV=development
PORT=3000
